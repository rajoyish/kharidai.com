includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Larastan derives Eloquent attribute types from casts() rather than real
    # declarations. Treating them as certain makes PHPStan report reachable
    # branches guarding those attributes as "always false".
    treatPhpDocTypesAsCertain: false
