APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kathmandu

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local runs the database queue, so no Redis is needed to develop: `composer run
# dev` starts a queue:listen worker alongside the server. Production sets this to
# `redis` and drains the queue from cron instead (see routes/console.php).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Production only. Port and password come from the host's Redis panel — they are
# not the defaults below.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs instead of sending it — the default for local
# work. To send for real through Gmail, switch to `smtp` and fill in the block
# below; `php artisan mail:test-order` will then send a live order email.
MAIL_MAILER=log

# Gmail SMTP. MAIL_PASSWORD is a 16-character Google App Password, NOT the account
# password — generate one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification). Port 587 with scheme `smtp` means STARTTLS.
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Gmail silently rewrites a From address it does not own, so this must be the
# authenticated account above (or one of its verified aliases).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Shop inbox notified when a customer places an order. Left blank on purpose:
# this repository is public, so real addresses live only in the deployed .env.
# No order email is sent while this is unset.
MAIL_ORDER_NOTIFICATION_ADDRESS=

# --- Mailer routing -----------------------------------------------------------
#
# Shop alerts and customer mail go out on different transports, because they have
# different requirements.
#
# The shop's alerts land in the owner's own inbox, so Gmail is fine: no
# deliverability risk, and it is not automated mail to a third party.
#
# Customer mail must come from our own authenticated domain through a
# transactional provider, or it reads as forged and lands in spam — and free
# Gmail's terms do not cover it. So it is gated: leave MAIL_CUSTOMER_MAILER unset
# and the customer is sent nothing at all, rather than something harmful.
#
# Both blank here means "use the default mailer above", which is what local wants.

MAIL_SHOP_MAILER=
MAIL_CUSTOMER_MAILER=

# Gmail, for the shop's own alerts. MAIL_GMAIL_PASSWORD is a 16-character Google
# App Password, not the account password.
MAIL_GMAIL_USERNAME=
MAIL_GMAIL_PASSWORD=

# Brevo, for customer mail. The username is the SMTP login from Brevo's panel,
# which is not the account email. Free tier is 300 emails/day.
MAIL_BREVO_USERNAME=
MAIL_BREVO_PASSWORD=

# The From address on customer mail. Must be on a domain authenticated with the
# provider above — the mailbox itself need not exist, though an address that can
# receive replies is worth more than one that cannot.
MAIL_CUSTOMER_FROM_ADDRESS=
MAIL_CUSTOMER_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME="https"
PUSHER_APP_CLUSTER="ap2"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Meta (Facebook) Pixel & Conversions API
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
# Set only while testing (Events Manager → Test Events). Leave EMPTY in production:
# Meta excludes test-coded events from attribution and ad optimisation.
META_TEST_EVENT_CODE=

