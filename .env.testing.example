APP_NAME=Kharidai
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Template for the Playwright suite's environment. The suite copies this to
# .env.testing and generates a key on first run, so there is nothing to set up
# by hand; .env.testing itself is gitignored.
#
# This file exists so the browser tests never touch development data.
# `php artisan serve` only forwards a whitelist of environment variables to the
# PHP process it spawns (APP_ENV is on that list, DB_CONNECTION is not), so the
# database settings have to be discovered by the served process itself — which
# is exactly what this file is for.
#
# DB_DATABASE is deliberately unset: it then defaults to the absolute
# database_path('database.sqlite'). A relative path would be resolved against
# the server's working directory, which `artisan serve` sets to public/.
#
# The Pest suite also runs under APP_ENV=testing and reads this file, but
# phpunit.xml pins DB_DATABASE=:memory:, which takes precedence.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
